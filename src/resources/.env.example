# application profile
APPLICATION_ACTIVE_PROFILE=dev|prod|local
APPLICATION_NAME=elasticsearch-management-tool-api
APPLICATION_PORT=8080
APPLICATION_VERSION=1.0.0
APPLICATION_WORKERS=1
APPLICATION_ACCESS_LOG=false

# logger
LOG_LEVEL=INFO|DEBUG
LOG_DIR=logs
LOG_FILE_NAME=app.log

# Elasticsearch
ES_HOST="http://localhost:9200"
ES_API_KEY="your-es-api-key"
ES_USER_ID="your-es-user-id"
ES_USER_PW="your-es-user-pw"
ES_CERTS="your-es-cert-file-path"
ES_VERIFY_CERTS=True|False
ES_MAX_CONNECTION=50
ES_TIMEOUT=30

# Prometheus
PROMETHEUS_URL="http://localhost:9090"

# Mongodb
MONGO_URI="mongodb://your-monogo-user-id:your-mongo-user-pw@localhost:27017"
MONGO_DB_NAME="elasticsearch_management"
MONGO_MAX_CONNECTIONS=100
MONGO_TIMEOUT=30000  # ms

# SSH/SFTP Dictionary Server Configuration
SSH_DICTIONARY_DIR="path-to-elasticsearch-analysis-folder"

# 각각의 대상 서버 노드마다 서로 다른 인증(ID/PW 혹은 SSH 키 기반) 방식을 사용할 수 있도록 JSON 배열 형태로 구성합니다.
# key_path 또는 password 중 각 서버에 필요한 인증 정보를 설정해 주십시오.
SSH_SERVERS='[{"host": "127.0.0.1", "port": 22, "username": "centos", "key_path": "/Users/username/.ssh/id_rsa"}, {"host": "127.0.0.2", "port": 22, "username": "centos", "password": "secure_password"}]'